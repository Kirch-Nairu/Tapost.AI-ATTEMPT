{
  "name": "tapost-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test:domain": "tsc -p tsconfig.domain.json && node --test tests/session.test.mjs tests/session-controller.test.mjs",
    "doctor": "npx expo-doctor@latest"
  },
  "dependencies": {
    "expo": "57.0.20",
    "expo-notifications": "57.0.17",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "6.0.3"
  }
}
